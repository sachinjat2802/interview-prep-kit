# ============================================
# Server Configuration
# ============================================
PORT=3001
NODE_ENV=development

# ============================================
# MongoDB Connection
# ============================================
# Use MongoDB Atlas free tier (M0)
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=mongodb://localhost:27017/interview-prep-kit

# ============================================
# Authentication
# ============================================
# Secret for signing JWT tokens — use a strong random string
JWT_SECRET=change-me-to-a-random-secret-in-production

# JWT token expiry (default: 7 days)
JWT_EXPIRES_IN=7d

# ============================================
# LLM Provider — Google Gemini
# ============================================
# Get a free API key from https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here

# Model to use (default: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# ============================================
# Client Configuration
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Allowed CORS origin for the backend (set to your deployed frontend URL in production)
CLIENT_URL=http://localhost:3000

# ============================================
# Scraping Configuration
# ============================================
# Max pages to crawl per company site
MAX_CRAWL_PAGES=10

# Request timeout in milliseconds
FETCH_TIMEOUT=10000

# Max response size in bytes (5MB)
MAX_RESPONSE_SIZE=5242880
